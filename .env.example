# Copy to .env locally. Never upload .env or paste your token into chat.
DISCORD_TOKEN=
# Discord server ID and your own Discord user ID (Developer Mode > Copy ID).
GUILD_ID=
OWNER_ID=
# Local default. Docker Compose overrides these with persistent mount paths.
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Conservative upload limit for delivery through Discord. Package multiple files as ZIP.
MAX_UPLOAD_MB=8
STORAGE_LIMIT_MB=2048
MAX_LISTINGS_PER_USER=25
LOG_LEVEL=INFO

